{
  "name": "bookshelf-scanner",
  "private": true,
  "workspaces": ["packages/*", "apps/web", "apps/api"],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@bookscanner/web",
    "dev:api": "turbo run dev --filter=@bookscanner/api",
    "dev:ai": "cd apps/ai-service && pdm run serve",
    "dev:all": "concurrently \"bun run dev:ai\" \"bun run dev:api\" \"bun run dev:web\"",
    "build": "turbo run build",
    "clean": "turbo run clean",
    "proto:generate": "buf generate"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.50.0",
    "@bufbuild/protoc-gen-es": "^2.0.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "concurrently": "^9.2.0",
    "prettier": "^3.8.1",
    "turbo": "^2.8.0"
  }
}
